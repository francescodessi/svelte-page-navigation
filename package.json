{
	"name": "@dflare/svelte-page-navigation",
	"version": "1.1.1",
	"description": "A simple Svelte component to handle pagination",
	"keywords": [
		"pagination",
		"Svelte",
		"SvelteKit",
		"svelte-kit",
		"svelte-component"
	],
	"homepage": "https://francescodessi.github.io/svelte-page-navigation/",
	"license": "MIT",
	"author": {
		"name": "Francesco Dessì"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/francescodessi/svelte-page-navigation.git"
	},
	"bugs": {
		"url": "https://github.com/francescodessi/svelte-page-navigation/issues"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "node --test tests/*.test.js",
		"test:browser": "playwright test",
		"test:compat": "node tests/compatibility.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"peerDependencies": {
		"svelte": "^3.54.0 || ^4.0.0 || ^5.0.0"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@picocss/pico": "1.5.13",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/package": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "24.19.2",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"publint": "0.3.25",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"svelte3": "npm:svelte@3.59.2",
		"svelte3min": "npm:svelte@3.54.0",
		"svelte4": "npm:svelte@4.2.20",
		"svelte4min": "npm:svelte@4.0.0",
		"svelte5min": "npm:svelte@5.0.0",
		"tslib": "2.8.1",
		"typescript": "6.0.3",
		"vite": "8.3.5"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"packageManager": "npm@12.2.1"
}
